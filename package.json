{
  "name": "pi-glance",
  "version": "0.1.0",
  "description": "Explore software states and operation guarantees with Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "skills",
    "examples",
    "benchmarks",
    "scripts/install-tlc.mjs",
    "scripts/overview.mjs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:tlc": "node scripts/install-tlc.mjs",
    "check:package": "node scripts/check-package.mjs",
    "overview": "node scripts/overview.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "typebox": "1.3.27"
  }
}
